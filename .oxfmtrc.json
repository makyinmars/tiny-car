{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".zig-cache/",
    "zig-out/",
    ".lambda/",
    ".local/",
    "zig-pkg/",
    "deps/"
  ]
}
