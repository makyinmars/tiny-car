{
  "name": "tiny-car",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "zig build -Dtarget=wasm32-emscripten -Doptimize=ReleaseSafe && node scripts/configure-web.mjs",
    "build:api": "node scripts/build-api.mjs",
    "lint": "oxlint --deny-warnings web server scripts tests",
    "format": "oxfmt --write web server scripts tests package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check web server scripts tests package.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.14"
}
